{
 "id": "l04",
 "title": "Yesterday",
 "goal": "Talk about the past: I wanted, I went, I came, I ate, I didn't, I couldn't, and yesterday or last night.",
 "steps": [
  {
   "type": "teach",
   "id": "l04-01",
   "audio": "l04-01",
   "say": "Today we go back in time. You already know mikhām, I want. To say I wanted, the ending -am stays, mi- stays, and the middle changes: khā becomes khāst. Say it out loud: mikhāstam.",
   "en": "I wanted",
   "fa": "می‌خواستم",
   "fin": "mikhāstam",
   "words": [
    {
     "fa": "می‌خواستم",
     "fin": "mikhāstam",
     "parts": [
      {
       "fin": "mi",
       "role": "prefix",
       "gloss": "ongoing"
      },
      {
       "fin": "khāst",
       "role": "stem",
       "gloss": "wanted (past stem)"
      },
      {
       "fin": "am",
       "role": "ending",
       "gloss": "I"
      }
     ]
    }
   ],
   "note": "mi- + khāst + -am. The past ending for 'I' is -am, like beram. The stem khāst is the past stem of 'want'."
  },
