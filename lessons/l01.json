{
 "id": "l01",
 "title": "I want to…",
 "goal": "Say what you want, don't want and can't do, with go / come / eat, here and there. No pronoun or 'to' needed.",
 "steps": [
  {
   "type": "teach",
   "id": "l01-01",
   "audio": "l01-01",
   "say": "Persian doesn't need a separate word for 'I'. It's built into the end of the verb: the -m on the end means 'I'. Listen, then say it out loud.",
   "en": "I want",
   "fa": "می‌خوام",
   "fin": "mikhām",
   "words": [
    {
     "fa": "می‌خوام",
     "fin": "mikhām",
     "parts": [
      {
       "fin": "mi",
       "role": "prefix",
       "gloss": "ongoing / present"
      },
      {
       "fin": "khā",
       "role": "stem",
       "gloss": "want"
      },
      {
       "fin": "m",
       "role": "ending",
       "gloss": "I"
      }
     ]
    }
   ],
   "note": "mi- + khā + -m: 'ongoing' + 'want' + 'I'."
  },
