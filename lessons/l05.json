      },
      {
       "fin": "khā",
       "role": "stem",
       "gloss": "want"
      },
      {
       "fin": "y",
       "role": "ending",
       "gloss": "you"
      }
     ]
    },
    {
     "fa": "بیای؟",
     "fin": "biyāy?",
     "parts": [
      {
       "fin": "bi",
       "role": "prefix",
       "gloss": "'to' (subjunctive)"
      },
      {
       "fin": "yā",
       "role": "stem",
       "gloss": "come"
      },
      {
       "fin": "y",
       "role": "ending",
       "gloss": "you"
      }
     ]
    }
   ],
   "note": "A question is the same sentence with rising intonation."
