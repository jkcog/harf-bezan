{
 "id": "l05",
 "title": "Questions and requests",
 "goal": "Ask yes/no questions with just your voice, use where / what / why / when, and ask 'can I...?' with mishe.",
 "steps": [
  {
   "type": "teach",
   "id": "l05-01",
   "audio": "l05-01",
   "say": "Welcome back. You already know that the ending -i or -y means 'you'. So 'I want' is mikhām, and 'you want' is mikhāy. Say it out loud.",
   "en": "you want",
   "fa": "می‌خوای",
   "fin": "mikhāy",
   "words": [
    {
     "fa": "می‌خوای",
     "fin": "mikhāy",
     "parts": [
      {
       "fin": "mi",
       "role": "prefix",
       "gloss": "ongoing / present"
      },
      {
       "fin": "khā",
       "role": "stem",
       "gloss": "want"
      },
      {
       "fin": "y",
       "role": "ending",
       "gloss": "you"
      }
     ]
    }
   ],
   "note": "mi + khā + -y: 'ongoing' + 'want' + 'you'."
  },
  {
