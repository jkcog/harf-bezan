{
 "id": "l03",
 "title": "Now and tomorrow",
 "goal": "Use the present tense for now and tomorrow: miram, miyām, mikhoram and their negatives, with alān, emruz, fardā, emshab, plus dāram for 'right now'.",
 "steps": [
  {
   "type": "teach",
   "id": "l03-01",
   "audio": "l03-01",
   "say": "Last time you learned beram, 'that I go', which you use after 'want'. Now the real present tense. Take off be- and put mi- instead: mi-r-am, miram. You already know mi- from mikhām and mitūnam. Say it out loud first.",
   "en": "I go / I'm going",
   "fa": "می‌رم",
   "fin": "miram",
   "words": [
    {
     "fa": "می‌رم",
     "fin": "miram",
     "parts": [
      {
       "fin": "mi",
       "role": "prefix",
       "gloss": "present (replaces be-)"
      },
      {
       "fin": "r",
       "role": "stem",
       "gloss": "go"
      },
      {
       "fin": "am",
       "role": "ending",
       "gloss": "I"
      }
     ]
    }
   ],
   "note": "be- becomes mi-: be-r-am to mi-r-am."
  },
